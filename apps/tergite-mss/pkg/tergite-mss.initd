#!/sbin/openrc-run
# Alpine's tergite-mss.service, without the hardening OpenRC has no equivalent for

description="Tergite Main Service Server (MSS)"
supervisor="supervise-daemon"
command="/usr/bin/tergite-mss"
command_args="serve --port 8002"
command_user="tergite-mss:tergite-mss"
directory="/var/lib/tergite-mss"
export MSS_CONFIG_FILE=/etc/tergite-mss/mss-config.toml
export PRIVATE_KEY_FILE=/etc/tergite-mss/private-mss-key.pem

depend() {
	need net
	after postgresql mongodb redis firewall
}

start_pre() {
	su -s /bin/sh tergite-mss -c "$command migrate"
}
