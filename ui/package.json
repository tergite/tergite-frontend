{
  "name": "tergite-dashboard",
  "private": true,
  "version": "2026.11.0-rc.10",
  "type": "module",
  "scripts": {
    "dev": "uv run --directory .. python main.py migrate && uv run --directory .. python -m dev.seed && uv run --directory .. python -m dev.stub_dashboard && start-server-and-test mss http-get://127.0.0.1:8002/health \"vite --host 127.0.0.1 --port 5173 --strictPort\"",
    "mss": "uv run --directory .. python main.py serve --port 8002",
    "build": "tsc && vite build",
    "test": "vitest ",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "generate:api": "uv run --directory .. --extra dev python -m dev.openapi.export && openapi-typescript ../dev/openapi/openapi.json -o src/lib/api/schema.d.ts",
    "check:api": "openapi-typescript ../dev/openapi/openapi.json -o src/lib/api/schema.d.ts --check",
    "preview": "vite preview",
    "e2e": "bash ../dev/e2e_native_test.sh",
    "visual-e2e": "VISUAL=True bash ../dev/e2e_native_test.sh"
  },
