#!/bin/sh
# Asks where MSS's database and Redis are, until a config exists; postinstall saves the answers

set -e

. /usr/share/debconf/confmodule

[ -f /etc/tergite-mss/mss-config.toml ] && exit 0

db_input high tergite-mss/database || true
db_go || true
db_get tergite-mss/database
if [ "$RET" = url ]; then
	db_input high tergite-mss/database_url || true
	db_input high tergite-mss/database_password || true
	db_go || true
fi

db_input high tergite-mss/redis || true
db_go || true
db_get tergite-mss/redis
if [ "$RET" = url ]; then
	db_input high tergite-mss/redis_url || true
	db_input high tergite-mss/redis_password || true
	db_go || true
fi
