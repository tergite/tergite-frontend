// Ships the journal of the tergite services, as systemd runs them from their packages, to
// Loki. Run by Grafana Alloy installed beside them, with ENVIRONMENT, GRAFANA_LOKI_URL and
// LOKI_LOGGER_ID set in its environment, e.g. in /etc/default/alloy: see the README.

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

loki.source.journal "tergite" {
	matches       = "_SYSTEMD_UNIT=tergite-mss.service"
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.process.tergite.receiver]
}

loki.process "tergite" {
	forward_to = [loki.write.default.receiver]

	stage.static_labels {
		values = {
			environment = sys.env("ENVIRONMENT"),
		}
	}
}

loki.write "default" {
	endpoint {
		url       = sys.env("GRAFANA_LOKI_URL")
		tenant_id = sys.env("LOKI_LOGGER_ID")
	}
	external_labels = {}
}
